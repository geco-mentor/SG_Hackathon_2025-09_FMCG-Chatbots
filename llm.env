# === Azure LLMs ===
# === Global LLM controls ===
LLM_TIMEOUT_SECONDS=25
LLM_RETRIES=2
LLM_BACKOFF_SECONDS=1.2
LLM_FAILOVER_ON_STATUS=401,403,404,408,429,500-599
LLM_FAILOVER_DEBUG=1

# === Legacy primary (LLM_0) ===
API_URL=API-url-here/chat/completions
API_KEY=API-key-here
MODEL=gpt-oss-120b

# === LLM no. 1 ===
LLM_1_API_URL=API-url-here/chat/completions
LLM_1_API_KEY=API-key-here
LLM_1_MODEL=DeepSeek-V3.2
LLM_1_AUTH_TYPE=bearer
LLM_1_HEADERS=

# === LLM no. 2 ===
LLM_2_API_URL=API-url-here/chat/completions
LLM_2_API_KEY=API-key-here
LLM_2_MODEL=gpt-5.1-chat
LLM_2_AUTH_TYPE=bearer
LLM_2_HEADERS=

# === LLM no. 3 ===
LLM_3_API_URL=API-url-here/chat/completions
LLM_3_API_KEY=API-key-here
LLM_3_MODEL=grok-4-fast-reasoning
LLM_3_AUTH_TYPE=bearer
LLM_3_HEADERS=

# === Paths / App ===
# DATA_DIR is set via docker-compose environment variable
# For local testing, use relative path:
# DATA_DIR=./Team_Cashew_Synthetic_Data #uncomment this for local machine testing
FLASK_SECRET=change-me-in-production
NIBBLES_PORT=5001
CLARITY_PORT=5000
# PORT is set by docker-compose for containers, not needed here